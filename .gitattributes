# Keep repository text deterministic across Windows development and Linux CI.
* text=auto eol=lf

# Windows command scripts require CRLF for broad compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat generated and media assets as binary.
*.bmp binary
*.db binary
*.dll binary
*.exe binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.ldf binary
*.mdf binary
*.nupkg binary
*.pdf binary
*.png binary
*.snk binary
*.zip binary
