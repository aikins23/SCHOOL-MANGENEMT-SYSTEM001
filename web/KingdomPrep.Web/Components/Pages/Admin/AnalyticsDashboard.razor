@code {
    private WebAnalyticsData _data = new();
    private bool _isLoading = false;
    private string _selectedTab = "all";

    protected override async Task OnInitializedAsync()
    {
        await LoadAnalyticsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _data.StudentCount > 0)
        {
            await RenderCharts();
        }
    }

    private async Task LoadAnalyticsAsync()
    {
        _isLoading = true;
        try
        {
            var tenant = await TenantContext.GetCurrentAsync();
            var schoolId = tenant.SchoolId;
            _data = await DashStats.GetAnalyticsDataAsync(schoolId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading analytics data: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadAnalyticsAsync();
        await RenderCharts();
    }

    private async Task SetTab(string tab)
    {
        _selectedTab = tab;
        await Task.Delay(50); // allow DOM to update canvases
        await RenderCharts();
    }

    private bool ShowTab(string category)
    {
        return _selectedTab == "all" || _selectedTab == category;
    }

    private async Task RenderCharts()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("renderNyansapoAnalyticsCharts", _data);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"JS Chart render note: {ex.Message}");
        }
    }

    private async Task PrintReport()
    {
        await JSRuntime.InvokeVoidAsync("print");
    }
}
