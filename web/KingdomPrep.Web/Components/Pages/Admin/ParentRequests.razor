@page "/admin/parent-requests"
@rendermode InteractiveServer
@attribute [Authorize(Policy = WebPermission.AdminUsersManage)]
@using KingdomPrep.Web.Data
@using KingdomPrep.Web.Data.Entities
@inject IParentPortalRepository RequestRepo
@inject IWardRepository WardRepo
@inject IPortalTenantContext TenantContext
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Parent Requests - Nyansapo ERP</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1 fw-bold" style="color: #0b1f48;">Parent Requests</h2>
            <p class="text-muted mb-0">Review parent submissions and update request status.</p>
        </div>
        <a class="btn btn-outline-primary fw-semibold" href="parent/requests">Parent View</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-success">@_message</div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted text-uppercase fw-semibold small mb-2">Requests</div>
                    <div class="fs-3 fw-bold">@_requests.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted text-uppercase fw-semibold small mb-2">Pending</div>
                    <div class="fs-3 fw-bold" style="color: #d97706;">@_requests.Count(r => r.Status == "Pending")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted text-uppercase fw-semibold small mb-2">Approved</div>
                    <div class="fs-3 fw-bold" style="color: #059669;">@_requests.Count(r => r.Status == "Approved")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted text-uppercase fw-semibold small mb-2">Rejected</div>
                    <div class="fs-3 fw-bold" style="color: #dc2626;">@_requests.Count(r => r.Status == "Rejected")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold text-muted">Search</label>
                    <input class="form-control" placeholder="Parent, ward ID, type, or details" @bind="_searchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted">Status</label>
                    <select class="form-select" @bind="_statusFilter">
                        <option value="">All statuses</option>
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex justify-content-md-end gap-2">
                    <button class="btn btn-primary fw-semibold px-4" @onclick="LoadAsync" disabled="@_isLoading">Apply</button>
                    <button class="btn btn-light fw-semibold px-4" @onclick="ClearFilters" disabled="@_isLoading">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Parent</th>
                            <th>Ward</th>
                            <th>Type</th>
                            <th>Details</th>
                            <th>Status</th>
                            @if (_canManageRequests)
                            {
                                <th class="text-end">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (_isLoading)
                        {
                            <tr><td colspan="@RequestTableColumnCount" class="text-center py-4"><span class="spinner-border spinner-border-sm"></span></td></tr>
                        }
                        else if (!_requests.Any())
                        {
                            <tr><td colspan="@RequestTableColumnCount" class="text-center text-muted py-4">No parent requests found.</td></tr>
                        }
                        else
                        {
                            @foreach (var request in _requests)
                            {
                                <tr>
                                    <td class="text-muted">@request.CreatedDate.ToString("dd MMM yyyy")</td>
                                    <td class="fw-semibold">@request.ParentUsername</td>
                                    <td>
                                        <div class="fw-semibold">@WardName(request.StudentID)</div>
                                        <div class="small text-muted">ID: @request.StudentID</div>
                                    </td>
                                    <td>@RequestTypeLabel(request.RequestType)</td>
                                    <td style="max-width: 340px;">@request.Details</td>
                                    <td><span class="badge @RequestStatusClass(request.Status)">@request.Status</span></td>
                                    @if (_canManageRequests)
                                    {
                                        <td class="text-end">
                                            @if (request.Status != "Approved")
                                            {
                                                <button class="btn btn-sm btn-outline-success me-2" @onclick='() => UpdateStatusAsync(request, "Approved")'>Approve</button>
                                            }
                                            @if (request.Status != "Rejected")
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick='() => UpdateStatusAsync(request, "Rejected")'>Reject</button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ParentRequestEntity> _requests = new();
    private Dictionary<int, string> _wardNames = new();
    private string _searchTerm = "";
    private string _statusFilter = "Pending";
    private string _message = "";
    private string _error = "";
    private bool _isLoading = true;
    private Guid? _schoolId;
    private string _actorUsername = "";
    private bool _canManageRequests;
    private int RequestTableColumnCount => _canManageRequests ? 7 : 6;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _canManageRequests = WebPermission.CanRenderAction(authState.User, WebPermission.AdminUsersManage);
        var tenant = await TenantContext.GetCurrentAsync();
        _schoolId = tenant.SchoolId;
        _actorUsername = tenant.Username ?? "system";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = "";
        _requests = await RequestRepo.GetAllRequestsAsync(_statusFilter, _searchTerm, _schoolId);
        await LoadWardNamesAsync();
        _isLoading = false;
    }

    private async Task LoadWardNamesAsync()
    {
        _wardNames = new Dictionary<int, string>();
        foreach (var studentId in _requests.Select(r => r.StudentID).Distinct())
        {
            var ward = await WardRepo.GetWardAsync(studentId, _schoolId);
            _wardNames[studentId] = ward?.FullName ?? $"Student {studentId}";
        }
    }

    private async Task ClearFilters()
    {
        _searchTerm = "";
        _statusFilter = "";
        await LoadAsync();
    }

    private async Task UpdateStatusAsync(ParentRequestEntity request, string status)
    {
        if (!_canManageRequests) return;

        try
        {
            await RequestRepo.UpdateRequestStatusAsync(request.RequestID, status, _schoolId, _actorUsername);
            _message = $"Parent request for {WardName(request.StudentID)} marked {status.ToLowerInvariant()}.";
            _error = "";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = "";
            _error = ex.Message;
        }
    }

    private string WardName(int studentId) =>
        _wardNames.TryGetValue(studentId, out var name) ? name : $"Student {studentId}";

    private static string RequestTypeLabel(string requestType) => requestType switch
    {
        "InformationChange" => "Information Change",
        "TransferLetter" => "Transfer Letter",
        _ => requestType
    };

    private static string RequestStatusClass(string status) => status switch
    {
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        _ => "bg-warning text-dark"
    };
}
