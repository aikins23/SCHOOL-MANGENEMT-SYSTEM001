    }

    private async Task TogglePublishSetup(ExamSetupEntity setup)
    {
        if (!_canPublishPortal) return;

        var existing = await DbContext.ExamSetups.FindAsync(setup.SetupID);
        if (existing == null) return;

        existing.IsPublishedToPortal = !existing.IsPublishedToPortal;
        existing.PublishedAt = existing.IsPublishedToPortal ? DateTime.UtcNow : null;
        existing.PublishedBy = existing.IsPublishedToPortal ? _currentUsername : null;
        existing.UpdatedAt = DateTime.UtcNow;
        DbContext.ExamSetups.Update(existing);
        await DbContext.SaveChangesAsync();

        _setupMessage = existing.IsPublishedToPortal
            ? $"{AssessmentDisplayName(existing)} uploaded to the parent portal."
            : $"{AssessmentDisplayName(existing)} removed from the parent portal.";
        _setupMessageIsError = false;
        await LoadHistory();
    }

    private async Task SaveSetup()
    {
        if (!_canManageSetup) return;

        _isSaving = true;
        _showSuccessMessage = false;
        _setupMessage = "";
        _setupMessageIsError = false;

        RecalculateWeights();

        if (string.IsNullOrWhiteSpace(_setup.Term) || string.IsNullOrWhiteSpace(_setup.Year))
        {
            _setupMessage = "Term and academic year are required.";
            _setupMessageIsError = true;
            _isSaving = false;
            return;
        }

        if (!_setup.ExamTypeId.HasValue)
        {
            _setupMessage = "Exam type is required.";
            _setupMessageIsError = true;
            _isSaving = false;
            return;
        }

        if (IsEndOfTermSelected())
        {
            _setup.AssessmentNumber = null;
        }
        else if (!_setup.AssessmentNumber.HasValue || _setup.AssessmentNumber.Value < 1)
        {
            _setupMessage = "Assessment number is required for non-end-of-term exams.";
            _setupMessageIsError = true;
            _isSaving = false;
            return;
        }

        _setup.AssessmentLabel = BuildAssessmentLabel(_setup);

        if (!_setup.StartDate.HasValue || !_setup.EndDate.HasValue)
        {
            _setupMessage = "Start date and end date are required.";
            _setupMessageIsError = true;
            _isSaving = false;
            return;
        }

        if (_setup.StartDate.Value.Date > _setup.EndDate.Value.Date)
        {
            _setupMessage = "Start date cannot be after end date.";
            _setupMessageIsError = true;
            _isSaving = false;
            return;
        }

        var duplicateExists = await DbContext.ExamSetups.AnyAsync(e =>
            e.SetupID != _editingSetupId &&
            e.Term == _setup.Term &&
            e.Year == _setup.Year &&
            e.ExamTypeId == _setup.ExamTypeId &&
            e.AssessmentNumber == _setup.AssessmentNumber &&
            e.SchoolId == _schoolId);
        if (duplicateExists)
        {
            _setupMessage = "An exam setup already exists for this term, year, exam type, and assessment number.";
            _setupMessageIsError = true;
            _isSaving = false;
            return;
        }

        if (_editingSetupId > 0)
        {
            var existing = await DbContext.ExamSetups.FindAsync(_editingSetupId);
            if (existing != null)
            {
                var now = DateTime.UtcNow;
                existing.Term = _setup.Term;
                existing.Year = _setup.Year;
                existing.ExamTypeId = _setup.ExamTypeId;
                existing.AssessmentNumber = _setup.AssessmentNumber;
                existing.AssessmentLabel = _setup.AssessmentLabel;
                existing.StartDate = _setup.StartDate;
                existing.EndDate = _setup.EndDate;
                existing.ClassWeight = _setup.ClassWeight;
                existing.ExamWeight = _setup.ExamWeight;
                existing.UpdatedAt = now;
                DbContext.ExamSetups.Update(existing);
                await DbContext.SaveChangesAsync();
            }
        }
        else
        {
            _setup.SchoolId = _schoolId;
            _setup.UpdatedAt = DateTime.UtcNow;
            DbContext.ExamSetups.Add(_setup);
            await DbContext.SaveChangesAsync();

            var teachers = await DbContext.Employees.Where(e => e.Position == "Teacher" && e.SchoolId == _schoolId).ToListAsync();
            foreach (var teacher in teachers)
            {
                if (!string.IsNullOrEmpty(teacher.Contact))
                {
                    var message = $"Dear {teacher.FullName}, the {_setup.Term} grading portal is now OPEN. Please submit all grades by {_setup.EndDate?.ToString("MMM dd")}. Class weight: {_setup.ClassWeight}%, Exam weight: {_setup.ExamWeight}%.";
                    Console.WriteLine($"[SMS Outbox] To: {teacher.Contact} - {message}");
                }
            }
        }

        CancelEditSetup();
        await LoadHistory();

        _showSuccessMessage = true;
        _isSaving = false;

        _ = Task.Delay(4000).ContinueWith(_ => { _showSuccessMessage = false; InvokeAsync(StateHasChanged); });
    }
}
