@code {
    private bool _isLoading = true;
    private string _username = "";
    private int _studentId;
    private Guid? _schoolId;

    private List<StudentEntity> _wards = new();
    private StudentEntity? _ward;
    private List<StudentFeeLedgerEntity> _feeLedger = new();
    private List<WardFeeBreakdownItem> _feeBreakdown = new();
    private List<(string Term, string Year)> _availableTerms = new();
    private AttendanceSummaryDto? _attendanceSummary;
    private List<AttendanceEntity> _attendanceRecords = new();

    private decimal _totalFamilyOutstanding = 0;
    private decimal _totalFamilyPaid = 0;
    private decimal _familyAverageAttendance = 0;

    private bool _isDownloading = false;
    private string _downloadingTerm = "";
    private string _downloadingYear = "";
    private string? _downloadError = null;
    private string _noticeFilter = "all";
    private string _searchQuery = "";

    private void SearchPayments()
    {
        // Search functionality placeholder
        StateHasChanged();
    }

    private void RefreshNotices()
    {
        // Refresh functionality placeholder
        StateHasChanged();
    }

    private void NavigateToFees()
    {
        // Navigation handled by button onclick
    }

    protected override async Task OnInitializedAsync()
    {
        var tenant = await TenantContext.GetCurrentAsync();
        _username = tenant.Username ?? "";
        _schoolId = tenant.SchoolId;

        _wards = await WardRepo.GetWardsForParentAsync(_username, _schoolId);

        if (_wards.Count == 0)
        {
            _studentId = ParseStudentId(_username);
            if (_studentId > 0)
            {
                var fallback = await WardRepo.GetWardAsync(_studentId, _schoolId);
                if (fallback != null) _wards.Add(fallback);
            }
        }

        if (_wards.Count > 0)
        {
            decimal totalOutstanding = 0;
            decimal totalPaid = 0;
            decimal totalAttendance = 0;
            int validAttendanceWards = 0;

            foreach(var w in _wards)
            {
                var breakdown = await BillingRepo.GetFeeBreakdownAsync(w.StudentID.ToString(), _schoolId);
                if (breakdown != null && breakdown.Any())
                {
                    totalOutstanding += breakdown.Sum(x => x.Outstanding);
                    totalPaid += breakdown.Sum(x => x.Paid);
                }

                var att = await AttendanceRepo.GetAttendanceSummaryAsync(w.StudentID.ToString(), _schoolId);
                if (att != null && att.TotalDays > 0)
                {
                    totalAttendance += att.AttendancePercentage;
                    validAttendanceWards++;
                }
            }

            _totalFamilyOutstanding = totalOutstanding;
            _totalFamilyPaid = totalPaid;
            _familyAverageAttendance = validAttendanceWards > 0 ? totalAttendance / validAttendanceWards : 0;

            _ward = _wards.First();
            await LoadActiveWardDataAsync();
        }
        else
        {
            _isLoading = false;
        }
    }

    private async Task SelectWard(StudentEntity ward)
    {
        _ward = ward;
        _isLoading = true;
        StateHasChanged();
        await LoadActiveWardDataAsync();
    }

    private int ParseStudentId(string username)
    {
        if (username.StartsWith("ns", StringComparison.OrdinalIgnoreCase))
        {
            if (int.TryParse(username.Substring(2), out int id))
                return id;
        }
        if (int.TryParse(username, out int raw)) return raw;
        return 0;
    }

    private async Task LoadActiveWardDataAsync()
    {
        if (_ward != null)
        {
            _feeLedger = await BillingRepo.GetFeeLedgerAsync(_ward.StudentID.ToString(), _schoolId);
            _feeBreakdown = await BillingRepo.GetFeeBreakdownAsync(_ward.StudentID.ToString(), _schoolId);
            _availableTerms = await ReportRepo.GetAvailableTermsAsync(_ward.StudentID.ToString(), _schoolId);
            _attendanceSummary = await AttendanceRepo.GetAttendanceSummaryAsync(_ward.StudentID.ToString(), _schoolId);
            _attendanceRecords = await AttendanceRepo.GetAttendanceRecordsAsync(_ward.StudentID.ToString(), _schoolId);
        }
        _isLoading = false;
    }

    private async Task DownloadReportCard(string term, string year)
    {
        if (_ward == null) return;

        _isDownloading = true;
        _downloadingTerm = term;
        _downloadingYear = year;
        StateHasChanged();

        try
        {
            var studentList = new List<StudentEntity> { _ward };
            var classResults = await ReportRepo.GetClassResultsAsync(_ward.ClassID ?? "", term, year, _schoolId);

            // Compute positions per subject for the entire class to give this student their rank
            var subjectPositions = new Dictionary<string, Dictionary<int, int>>();
            var bySubject = classResults.Where(r => r.Subject != null && r.StudentId.HasValue).GroupBy(r => r.Subject!);
            foreach (var subGroup in bySubject)
            {
                var ordered = subGroup.OrderByDescending(r => r.TotalScore ?? 0).ToList();
                var posDict = new Dictionary<int, int>();
                int currentPos = 1;
                for (int i = 0; i < ordered.Count; i++)
                {
                    if (i > 0 && ordered[i].TotalScore < ordered[i - 1].TotalScore)
                        currentPos = i + 1;
                    posDict[ordered[i].StudentId!.Value] = currentPos;
                }
                subjectPositions[subGroup.Key] = posDict;
            }

            // Compute overall position
            var overallScores = classResults.Where(r => r.StudentId.HasValue)
                                            .GroupBy(r => r.StudentId!.Value)
                                            .Select(g => new { StudentId = g.Key, Total = g.Sum(r => r.TotalScore ?? 0) })
                                            .OrderByDescending(x => x.Total)
                                            .ToList();
            var overallPositions = new Dictionary<int, int>();
            int overallPos = 1;
            for (int i = 0; i < overallScores.Count; i++)
            {
                if (i > 0 && overallScores[i].Total < overallScores[i - 1].Total)
                    overallPos = i + 1;
                overallPositions[overallScores[i].StudentId] = overallPos;
            }

            var results = classResults.Where(r => r.StudentId == _ward.StudentID).ToList();
            var remarks = await ReportRepo.GetRemarksAsync(_ward.StudentID.ToString(), term, year, _schoolId);
            var oPos = overallPositions.TryGetValue(_ward.StudentID, out var p) ? p : 0;
            var termOptions = await Db.AcademicTerms.AsNoTracking()
                .Where(t => t.SchoolId == _schoolId)
                .OrderByDescending(t => t.StartDate)
                .ToListAsync();
            var termInfo = termOptions.FirstOrDefault(t => TermsMatch(t.TermName, term));

            var dto = new ReportCardStudentDto
            {
                StudentId = _ward.StudentID.ToString(),
                FullName = _ward.FullName ?? "",
                HeadTeacherRemark = remarks?.HeadTeacherRemarks ?? "",
                TeacherRemark = remarks?.ClassTeacherRemarks ?? "",
                Attitude = remarks?.Attitude ?? "",
                Interest = remarks?.Interest ?? "",
                Conduct = remarks?.Conduct ?? "",
                TotalStudentsInClass = overallScores.Count > 0 ? overallScores.Count : 1,
                Gender = _ward.Gender ?? "",
                OverallPosition = oPos,
                TermClosingDate = termInfo?.EndDate,
                TermReopeningDate = termInfo?.ReopeningDate,
                Grades = results.Select(r => new ReportCardGradeDto
                {
                    Subject = r.Subject ?? "",
                    CategoryTotal = (decimal)(r.CategoryTotal ?? 0),
                    ExamScore = (decimal)(r.ExamScore ?? 0),
                    TotalScore = (decimal)(r.TotalScore ?? 0),
                    Grade = r.Grade ?? "",
                    Remark = r.Remark ?? "",
                    PositionInClass = r.Subject != null && subjectPositions.ContainsKey(r.Subject) && subjectPositions[r.Subject].ContainsKey(_ward.StudentID)
                                      ? subjectPositions[r.Subject][_ward.StudentID] : 0
                }).ToList()
            };

            var dtoList = new List<ReportCardStudentDto> { dto };

            var schoolProfile = await SchoolProfileService.GetSchoolProfileAsync();
            var printableProfile = new WebSchoolProfileDto
            {
                Name = schoolProfile?.Name ?? "",
                Address = schoolProfile?.Address ?? "",
                PhoneNumbers = schoolProfile?.Phones ?? "",
                Logo = schoolProfile?.Logo
            };

            var pdfBytes = await Task.Run(() => ReportGenerator.GenerateBatchReportCards(_ward.ClassID ?? "", term, year, dtoList, printableProfile));

            using var stream = new System.IO.MemoryStream(pdfBytes);
            using var streamRef = new DotNetStreamReference(stream);
            var fileName = $"ReportCard_{_ward.FirstName}_{_ward.LastName}_Term_{term}_{year}.pdf";
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            // Log error
            Console.WriteLine(ex.Message);
            _downloadError = ex.Message;
        }
        finally
        {
            _isDownloading = false;
            StateHasChanged();
        }
    }

    private static bool TermsMatch(string? left, string? right)
    {
        return NormalizeTerm(left) == NormalizeTerm(right);
    }

    private static string NormalizeTerm(string? term)
    {
        var value = (term ?? "").Trim().ToUpperInvariant();
        return value switch
        {
            "TERM 1" or "1ST TERM" or "FIRST TERM" => "FIRST",
            "TERM 2" or "2ND TERM" or "SECOND TERM" => "SECOND",
            "TERM 3" or "3RD TERM" or "THIRD TERM" => "THIRD",
            _ => value
        };
    }
}
