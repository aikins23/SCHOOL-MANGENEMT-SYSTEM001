@page "/parent/dashboard"
@rendermode InteractiveServer
@using KingdomPrep.Web.Data
@using KingdomPrep.Web.Data.Entities
@using KingdomPrep.Web.Core
@using Microsoft.EntityFrameworkCore
@inject IWardRepository WardRepo
@inject IWardBillingRepository BillingRepo
@inject IReportCardPortalRepository ReportRepo
@inject IAttendancePortalRepository AttendanceRepo
@inject WebReportCardGenerator ReportGenerator
@inject ISchoolProfileService SchoolProfileService
@inject AppDbContext Db
@inject IJSRuntime JS
@inject IPortalTenantContext TenantContext
@attribute [Authorize(Roles = "Parent")]

<PageTitle>My Ward - Parent Portal</PageTitle>

<div class="container-fluid py-4" style="background-color: #f8fafc; min-height: 100vh;">
    <!-- Breadcrumb / Top Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="text-muted small fw-medium" style="font-family: 'Inter', sans-serif;">Home <i class="bi bi-chevron-right mx-1" style="font-size: 0.7rem;"></i> <span class="text-dark fw-bold">Parents</span></div>
            <h3 class="mb-0 mt-2 fw-bold text-dark">Welcome back, @_username!</h3>
            <p class="text-muted small mb-0 mt-1">Here's what's happening with your children today</p>
        </div>
        @if (_wards != null && _wards.Any())
        {
            <div class="d-none d-md-block">
                <div class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                    <i class="bi bi-people-fill me-1"></i> @_wards.Count @(_wards.Count == 1 ? "Child" : "Children")
                </div>
            </div>
        }
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted fw-medium">Loading your ward's information...</p>
        </div>
    }
    else if (_wards == null || !_wards.Any())
    {
        <div class="alert alert-warning shadow-sm border-0 d-flex align-items-center p-4 rounded-4" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-3 text-warning"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            <div>
                <h5 class="alert-heading fw-bold mb-1">No Student Linked</h5>
                <p class="mb-0 text-dark">We could not find any students linked to your account (@_username). Please contact the administration.</p>
            </div>
        </div>
    }
    else
    {
        <!-- Quick Action Alert for Outstanding Fees -->
        @if (_totalFamilyOutstanding > 0)
        {
            <div class="alert border-0 shadow-sm rounded-4 mb-4 d-flex flex-column align-items-start justify-content-between gap-3 position-relative overflow-hidden" style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);">
                <svg class="position-absolute" style="width: 8rem; height: 8rem; opacity: 0.08; right: -20px; top: -20px; color: #d97706;" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M10.29 3.86a2 2 0 0 1 3.42 0l8.49 14.14A2 2 0 0 1 20.49 21H3.51a2 2 0 0 1-1.71-3L10.29 3.86ZM11 9v5h2V9h-2Zm0 7v2h2v-2h-2Z" />
                </svg>
                <div class="d-flex align-items-start flex-grow-1 position-relative w-100">
                    <div class="me-3 flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle" style="width: 48px; height: 48px; background: rgba(217, 119, 6, 0.15);">
                        <svg style="width: 26px; height: 26px; color: #d97706;" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M10.29 3.86a2 2 0 0 1 3.42 0l8.49 14.14A2 2 0 0 1 20.49 21H3.51a2 2 0 0 1-1.71-3L10.29 3.86ZM11 9v5h2V9h-2Zm0 7v2h2v-2h-2Z" />
                        </svg>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="mb-1 fw-bold text-dark d-flex flex-wrap align-items-center gap-2">
                            <span>Outstanding Fees: GHS @_totalFamilyOutstanding.ToString("N0")</span>
                            <span class="badge bg-danger text-white px-2 py-1 rounded-pill" style="font-size: 0.7rem;">Action Required</span>
                        </h6>
                        <p class="mb-0 small text-dark">You have pending fees that need to be cleared.</p>
                    </div>
                </div>
                <a href="parent/fees" class="btn btn-warning fw-bold shadow-sm rounded-pill px-4 text-nowrap w-100 w-md-auto position-relative">
                    <svg class="me-2" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="5" width="20" height="14" rx="2" />
                        <path d="M2 10h20" />
                    </svg>
                    Pay Now
                </a>
            </div>
        }

        <div class="row g-4">
            <!-- LEFT COLUMN -->
            <div class="col-lg-5 col-xl-4">
                @foreach (var (w, index) in _wards.Select((w, i) => (w, i)))
                {
                    var isSelected = _ward?.StudentID == w.StudentID;
                    var cardOpacity = isSelected ? "1" : "0.7";
                    var cardShadow = isSelected ? "shadow" : "shadow-sm";
                    var cardBorder = isSelected ? "border border-2 border-warning" : "";
                    <div class="card border-0 rounded-4 mb-4 premium-card hover-lift transition-all @cardBorder @cardShadow" style="cursor: pointer; position: relative; overflow: hidden; opacity: @cardOpacity;" @onclick="() => SelectWard(w)">
                        @if (isSelected)
                        {
                            <div class="position-absolute glow-border" style="left:0; top:0; bottom:0; width:6px; background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%); box-shadow: 0 0 15px rgba(245, 158, 11, 0.5);"></div>
                        }
                        else
                        {
                            <div class="position-absolute" style="left:0; top:0; bottom:0; width:6px; background: #e2e8f0;"></div>
                        }

                        <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-bold text-dark fs-5">@w.FirstName @w.LastName</h6>
                            <div class="d-flex gap-2">
                                <span class="badge @(isSelected ? "bg-warning text-dark" : "bg-light text-muted") rounded-pill px-3">@(isSelected ? "Active View" : "Click to view")</span>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                <div class="col-12 col-md-5 text-center mb-4 mb-md-0">
                                    @{
                                        string initial = w.FirstName?.FirstOrDefault().ToString().ToUpper() ?? "U";
                                        string bgGradient = w.Gender?.ToLower() == "female" ? "linear-gradient(135deg, #ec4899 0%, #be185d 100%)" : "linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)";
                                    }
                                    <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm border border-4 border-white" style="width: 110px; height: 110px; background: @bgGradient; font-size: 3rem; font-weight: bold;">
                                        @initial
                                    </div>
                                    <div class="d-flex justify-content-center gap-2 border-top pt-3 mt-2 px-2">
                                        @if (isSelected && _availableTerms != null && _availableTerms.Any())
                                        {
                                            var latestWardReport = _availableTerms.First();
                                            <button class="btn btn-sm btn-primary rounded-pill px-3 py-1 hover-lift shadow-sm" style="font-size: 0.75rem;" title="Download Latest Report" @onclick:stopPropagation="true" @onclick="() => DownloadReportCard(latestWardReport.Term, latestWardReport.Year)" disabled="@_isDownloading">
                                                @if (_isDownloading)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1" role="status" style="width: 0.6rem; height: 0.6rem;"></span>
                                                    <span>Downloading...</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-download me-1"></i>
                                                    <span>Download Report</span>
                                                }
                                            </button>
                                        }
                                        else if (isSelected)
                                        {
                                            <small class="text-muted py-1">No reports available</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted py-1">Select to view actions</small>
                                        }
                                    </div>
                                </div>
                                <div class="col-12 col-md-7">
                                    <div class="bg-light p-3 rounded-4 border border-light shadow-sm">
                                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                            <span class="text-muted fw-semibold small">Student ID</span>
                                            <span class="text-dark fw-bold text-end">#@w.StudentID</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                            <span class="text-muted fw-semibold small">Class</span>
                                            <span class="text-dark fw-bold text-end">@(w.ClassID ?? "N/A")</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                            <span class="text-muted fw-semibold small">Gender</span>
                                            <span class="text-dark fw-bold text-end">@(w.Gender ?? "N/A")</span>
                                        </div>
                                        @if (isSelected)
                                        {
                                            var wardBalance = _feeLedger.Sum(l => l.TotalExpectedAmount - l.TotalPaidAmount);
                                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                                <span class="text-muted fw-semibold small">Outstanding</span>
                                                <span class="@(wardBalance > 0 ? "text-danger" : "text-success") fw-bold text-end">
                                                    GHS @wardBalance.ToString("N0")
                                                </span>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="text-muted fw-semibold small">Attendance</span>
                                                <span class="text-dark fw-bold text-end">
                                                    @if (_attendanceSummary != null && _attendanceSummary.TotalDays > 0)
                                                    {
                                                        <span class="@(_attendanceSummary.AttendancePercentage >= 80 ? "text-success" : _attendanceSummary.AttendancePercentage >= 60 ? "text-warning" : "text-danger")">
                                                            @_attendanceSummary.AttendancePercentage.ToString("0")%
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>N/A</span>
                                                    }
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="text-muted fw-semibold small">Date of Birth</span>
                                                <span class="text-dark fw-bold text-end">@(w.DateOfBirth?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Quick Action Blocks (matching the 4 colored blocks) -->
                <div class="row g-2 g-md-3 mb-4">
                    <div class="col-6">
                        <a href="parent/fees" class="text-decoration-none">
                            <div class="parent-action-card parent-action-indigo">
                                <svg class="parent-action-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M19 7V6a2 2 0 0 0-2-2H5a3 3 0 0 0 0 6h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a3 3 0 0 1-3-3V7" />
                                    <path d="M16 13h.01" />
                                </svg>
                                <div class="parent-action-icon-wrap">
                                    <svg class="parent-action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M19 7V6a2 2 0 0 0-2-2H5a3 3 0 0 0 0 6h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a3 3 0 0 1-3-3V7" />
                                        <path d="M16 13h.01" />
                                    </svg>
                                </div>
                                <div class="d-flex flex-column border-start-0 border-xl-start ps-0 ps-xl-3 border-light border-opacity-25 position-relative">
                                    <span class="small opacity-75 text-uppercase fw-bold d-none d-xl-block" style="letter-spacing: 0.05em; font-size: 0.7rem;">Action</span>
                                    <span class="fw-bold fs-6 fs-md-5">Pay Fees</span>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="parent/assignments" class="text-decoration-none">
                            <div class="parent-action-card parent-action-sky">
                                <svg class="parent-action-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                                    <path d="M9 7h6" />
                                    <path d="M9 11h6" />
                                </svg>
                                <div class="parent-action-icon-wrap">
                                    <svg class="parent-action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                                        <path d="M9 7h6" />
                                        <path d="M9 11h6" />
                                    </svg>
                                </div>
                                <div class="d-flex flex-column border-start-0 border-xl-start ps-0 ps-xl-3 border-light border-opacity-25 position-relative">
                                    <span class="small opacity-75 text-uppercase fw-bold d-none d-xl-block" style="letter-spacing: 0.05em; font-size: 0.7rem;">Action</span>
                                    <span class="fw-bold fs-6 fs-md-5">Homework</span>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="parent/requests" class="text-decoration-none">
                            <div class="parent-action-card parent-action-red">
                                <svg class="parent-action-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="14" rx="2" />
                                    <path d="m3 7 9 6 9-6" />
                                </svg>
                                <div class="parent-action-icon-wrap">
                                    <svg class="parent-action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect x="3" y="5" width="18" height="14" rx="2" />
                                        <path d="m3 7 9 6 9-6" />
                                    </svg>
                                </div>
                                <div class="d-flex flex-column border-start-0 border-xl-start ps-0 ps-xl-3 border-light border-opacity-25 position-relative">
                                    <span class="small opacity-75 text-uppercase fw-bold d-none d-xl-block" style="letter-spacing: 0.05em; font-size: 0.7rem;">Action</span>
                                    <span class="fw-bold fs-6 fs-md-5">Request</span>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/settings" class="text-decoration-none">
                            <div class="parent-action-card parent-action-cyan">
                                <svg class="parent-action-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z" />
                                    <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6V20a2 2 0 1 1-4 0v-.08a1.7 1.7 0 0 0-1-.52 1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1H4a2 2 0 1 1 0-4h.08a1.7 1.7 0 0 0 .52-1 1.7 1.7 0 0 0-.34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6V4a2 2 0 1 1 4 0v.08a1.7 1.7 0 0 0 1 .52 1.7 1.7 0 0 0 1.88-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.23.34.43.68.6 1H20a2 2 0 1 1 0 4h-.08a1.7 1.7 0 0 0-.52 1Z" />
                                </svg>
                                <div class="parent-action-icon-wrap">
                                    <svg class="parent-action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z" />
                                        <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6V20a2 2 0 1 1-4 0v-.08a1.7 1.7 0 0 0-1-.52 1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1H4a2 2 0 1 1 0-4h.08a1.7 1.7 0 0 0 .52-1 1.7 1.7 0 0 0-.34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6V4a2 2 0 1 1 4 0v.08a1.7 1.7 0 0 0 1 .52 1.7 1.7 0 0 0 1.88-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.23.34.43.68.6 1H20a2 2 0 1 1 0 4h-.08a1.7 1.7 0 0 0-.52 1Z" />
                                    </svg>
                                </div>
                                <div class="d-flex flex-column border-start-0 border-xl-start ps-0 ps-xl-3 border-light border-opacity-25 position-relative">
                                    <span class="small opacity-75 text-uppercase fw-bold d-none d-xl-block" style="letter-spacing: 0.05em; font-size: 0.7rem;">Action</span>
                                    <span class="fw-bold fs-6 fs-md-5">Settings</span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN -->
            <div class="col-lg-7 col-xl-8">
                <!-- 4 Stat Cards -->
                <!-- 4 Stat Cards -->
                <div class="row g-4 mb-4">
                    <div class="col-sm-6 col-md-6">
                        <div class="card border-0 rounded-4 shadow-sm overflow-hidden h-100 hover-lift premium-card transition-all position-relative" style="cursor: pointer;" @onclick="() => NavigateToFees()">
                            <div class="d-flex h-100">
                                <div class="parent-metric-icon-panel text-white" style="width: 35%; background: linear-gradient(135deg, #f43f5e 0%, #be123c 100%);">
                                    <svg class="parent-metric-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M19 7V6a2 2 0 0 0-2-2H5a3 3 0 0 0 0 6h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a3 3 0 0 1-3-3V7" />
                                        <path d="M16 13h.01" />
                                    </svg>
                                    <svg class="parent-metric-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M19 7V6a2 2 0 0 0-2-2H5a3 3 0 0 0 0 6h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a3 3 0 0 1-3-3V7" />
                                        <path d="M16 13h.01" />
                                    </svg>
                                </div>
                                <div class="bg-white p-4 d-flex flex-column justify-content-center" style="width: 65%;">
                                    <h2 class="mb-1 fw-bold text-slate-800">GHS @_totalFamilyOutstanding.ToString("N0")</h2>
                                    <span class="text-muted fw-semibold text-uppercase small d-block mb-2" style="letter-spacing: 0.05em;">Outstanding Balance</span>
                                    @if (_totalFamilyOutstanding > 0)
                                    {
                                        <button class="btn btn-sm btn-danger rounded-pill mt-1 shadow-sm" style="font-size: 0.7rem;" @onclick:stopPropagation="true" @onclick="() => NavigateToFees()">
                                            <i class="bi bi-credit-card me-1"></i> Pay Now
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill mt-1 shadow-sm" style="font-size: 0.7rem;">
                                            All Paid
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-6">
                        <div class="card border-0 rounded-4 shadow-sm overflow-hidden h-100 hover-lift premium-card transition-all position-relative">
                            <div class="d-flex h-100">
                                <div class="parent-metric-icon-panel text-white" style="width: 35%; background: linear-gradient(135deg, #10b981 0%, #047857 100%);">
                                    <svg class="parent-metric-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                        <path d="M14 2v6h6" />
                                        <path d="M8 13h8" />
                                        <path d="M8 17h6" />
                                    </svg>
                                    <svg class="parent-metric-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                        <path d="M14 2v6h6" />
                                        <path d="M8 13h8" />
                                        <path d="M8 17h6" />
                                    </svg>
                                </div>
                                <div class="bg-white p-4 d-flex flex-column justify-content-center" style="width: 65%;">
                                    <h2 class="mb-1 fw-bold text-slate-800">@(_availableTerms?.Count ?? 0)</h2>
                                    <span class="text-muted fw-semibold text-uppercase small d-block mb-2" style="letter-spacing: 0.05em;">Terminal Reports</span>
                                    @if ((_availableTerms?.Count ?? 0) > 0)
                                    {
                                        var latestReport = _availableTerms![0];
