@page "/login"
@attribute [AllowAnonymous]
@layout BlankLayout
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IAuthService Auth
@inject NavigationManager Nav

<PageTitle>Sign in - Kingdom Preparatory</PageTitle>

<div class="login-wrap">
    <h1>Kingdom Preparatory School</h1>
    <h2>Sign in</h2>
    @if (ShowError)
    {
        <p class="login-error">Invalid username or password.</p>
    }
    <EditForm Model="Input" method="post" OnValidSubmit="DoLogin" FormName="login">
        <DataAnnotationsValidator />
        <div class="login-field">
            <label>Username</label>
            <InputText @bind-Value="Input.Username" autocomplete="username" />
        </div>
        <div class="login-field">
            <label>Password</label>
            <InputText type="password" @bind-Value="Input.Password" autocomplete="current-password" />
        </div>
        <button type="submit">Sign in</button>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm] private LoginInput Input { get; set; } = new();
    [SupplyParameterFromQuery(Name = "error")] private string? ErrorFlag { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private bool ShowError => ErrorFlag == "1";

    private async Task DoLogin()
    {
        var user = await Auth.AuthenticateAsync(Input.Username, Input.Password);
        if (user is null || user.Role == UserRole.Unknown)
        {
            Nav.NavigateTo("/login?error=1", forceLoad: true);
            return;
        }
        if (user.Role == UserRole.Accountant)
        {
            Nav.NavigateTo("/denied?accountant=1", forceLoad: true);
            return;
        }

        var claims = new List<Claim>
        {
            new(ClaimTypes.Name, user.Username),
            new(ClaimTypes.Role, user.Role.ToString())
        };
        if (user.EmploymentId.HasValue)
        {
            claims.Add(new("EmploymentId", user.EmploymentId.Value.ToString()));
        }
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme,
            new ClaimsPrincipal(identity));

        Nav.NavigateTo("/", forceLoad: true);
    }

    public sealed class LoginInput
    {
        [Required] public string Username { get; set; } = "";
        [Required] public string Password { get; set; } = "";
    }
}
