@page "/teacher/performance-reports"
@rendermode InteractiveServer
@attribute [Authorize(Policy = WebPermission.TeacherGradesManage)]
@using KingdomPrep.Web.Data
@using KingdomPrep.Web.Data.Entities
@inject ITeacherPortalRepository TeacherRepo
@inject IStudentPortalRepository StudentRepo
@inject IGradingPortalRepository GradingRepo
@inject IPerformanceReportRepository PerformanceRepo
@inject NavigationManager NavManager
@inject IPortalTenantContext TenantContext

<PageTitle>Class Performance Reports - Nyansapo ERP</PageTitle>

<div class="container-fluid py-4" style="background-color: #f6f8fb; min-height: calc(100vh - 5rem);">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1" style="font-weight: 600; color: #11233a; font-size: 2rem;">Class Performance Reports</h2>
            <p class="mb-0 text-muted" style="font-size: 0.95rem;">Submit weekly, monthly, or termly performance notes for headmaster approval</p>
        </div>
        <button class="btn text-white fw-semibold px-4 shadow-sm" style="background-color: #11233a; border-radius: 4px;" @onclick="SubmitReport" disabled="@_isSaving">
            @if (_isSaving) { <span class="spinner-border spinner-border-sm"></span> } else { <span>Submit for Approval</span> }
        </button>
    </div>

    <div class="card border-0 shadow-sm mb-3" style="border-radius: 6px;">
        <div class="card-body p-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">Class</label>
                    <select class="form-select fw-semibold" @bind="_selectedClass" @bind:after="LoadClassStudents">
                        @foreach (var item in _assignedClasses)
                        {
                            <option value="@item.ClassName">@item.ClassName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">Period</label>
                    <select class="form-select fw-semibold" @bind="_report.ReportPeriod">
                        <option>Weekly</option>
                        <option>Monthly</option>
                        <option>Termly</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">Term</label>
                    <input class="form-control fw-semibold" value="@_report.Term" readonly />
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">Academic Year</label>
                    <input class="form-control fw-semibold" value="@_report.AcademicYear" readonly />
                </div>
                <div class="col-md-1">
                    <label class="form-label text-muted small fw-bold">Week</label>
                    <input type="number" min="1" max="16" class="form-control" @bind="_report.WeekNumber" />
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">Month</label>
                    <input type="number" min="1" max="12" class="form-control" @bind="_report.MonthNumber" />
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") py-2">@_message</div>
    }

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
    }
    else if (!_assignedClasses.Any())
    {
        <div class="card border-0 shadow-sm"><div class="card-body p-5 text-center text-muted">No assigned class was found for this teacher account.</div></div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm" style="border-radius: 6px;">
                    <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
                        <h5 class="fw-bold mb-1" style="color: #11233a;">Class Summary</h5>
                        <p class="text-muted small mb-0">This summary becomes visible to parents after approval.</p>
                    </div>
                    <div class="card-body p-4">
                        <textarea class="form-control" rows="11" placeholder="Describe the class performance, strengths, challenges, and next steps..." @bind="_report.ReportText"></textarea>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm" style="border-radius: 6px;">
                    <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
                        <h5 class="fw-bold mb-1" style="color: #11233a;">Student Notes</h5>
                        <p class="text-muted small mb-0">Entries with notes, trends, exercise marks, or homework marks are submitted.</p>
                    </div>
                    <div class="table-responsive" style="max-height: calc(100vh - 350px); overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="px-4">Student</th>
                                    <th style="width: 160px;">Trend</th>
                                    <th style="width: 160px;">Exercise</th>
                                    <th style="width: 160px;">Homework</th>
                                    <th class="px-3">Teacher Note</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in _students)
                                {
                                    var entry = EntryFor(student.StudentID);
                                    <tr>
                                        <td class="px-4 fw-semibold">@student.FullName</td>
                                        <td>
                                            <select class="form-select form-select-sm" @bind="entry.PerformanceTrend">
                                                <option>Improving</option>
                                                <option>Stable</option>
                                                <option>Declining</option>
                                            </select>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-1">
                                                <input type="number" min="0" step="0.01" class="form-control form-control-sm" placeholder="Got" @bind="entry.ExerciseMarksObtained" />
                                                <span class="text-muted small">/</span>
                                                <input type="number" min="0" step="0.01" class="form-control form-control-sm" placeholder="Total" @bind="entry.ExerciseMarksTotal" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-1">
                                                <input type="number" min="0" step="0.01" class="form-control form-control-sm" placeholder="Got" @bind="entry.HomeworkMarksObtained" />
                                                <span class="text-muted small">/</span>
                                                <input type="number" min="0" step="0.01" class="form-control form-control-sm" placeholder="Total" @bind="entry.HomeworkMarksTotal" />
                                            </div>
                                        </td>
                                        <td class="px-3">
                                            <input class="form-control form-control-sm" placeholder="Optional note for parent" @bind="entry.TeacherNotes" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private int _employmentId;
    private Guid? _schoolId;
    private bool _isLoading = true;
    private bool _isSaving;
    private string _message = "";
    private bool _messageIsError;
    private string _selectedClass = "";
    private List<ClassAssignmentEntity> _assignedClasses = new();
    private List<StudentEntity> _students = new();
    private readonly Dictionary<int, StudentPerformanceEntryEntity> _entries = new();
    private ClassPerformanceReportEntity _report = new() { ReportPeriod = "Monthly" };

    protected override async Task OnInitializedAsync()
    {
        var tenant = await TenantContext.GetCurrentAsync();
        if (!tenant.EmploymentId.HasValue)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        _employmentId = tenant.EmploymentId.Value;
        _schoolId = tenant.SchoolId;
        _assignedClasses = await TeacherRepo.GetAssignedClassesAsync(_employmentId, _schoolId);
        _selectedClass = _assignedClasses.FirstOrDefault()?.ClassName ?? "";

        var setup = await GradingRepo.GetOpenExamSetupAsync(_schoolId) ?? await GradingRepo.GetLatestExamSetupAsync(_schoolId);
        _report.Term = setup?.Term ?? "First Term";
        _report.AcademicYear = setup?.Year ?? "2025/2026";
        _report.WeekNumber = WeekOfMonth(DateTime.Today);
        _report.MonthNumber = DateTime.Today.Month;

        if (!string.IsNullOrWhiteSpace(_selectedClass))
        {
            await LoadClassStudents();
        }

        _isLoading = false;
    }

    private async Task LoadClassStudents()
    {
        _students = await StudentRepo.GetStudentsAsync(classFilter: _selectedClass, schoolId: _schoolId);
        _entries.Clear();
        foreach (var student in _students)
        {
            _entries[student.StudentID] = new StudentPerformanceEntryEntity
            {
                StudentId = student.StudentID.ToString(),
                PerformanceTrend = "Stable"
            };
        }
    }

    private StudentPerformanceEntryEntity EntryFor(int studentId)
    {
        if (!_entries.TryGetValue(studentId, out var entry))
        {
            entry = new StudentPerformanceEntryEntity { StudentId = studentId.ToString(), PerformanceTrend = "Stable" };
            _entries[studentId] = entry;
        }
        return entry;
    }

    private async Task SubmitReport()
    {
        _isSaving = true;
        _message = "";
        _messageIsError = false;

        try
        {
            _report.ClassId = _selectedClass;
            var result = await PerformanceRepo.SubmitTeacherReportAsync(_employmentId, _report, _entries.Values, _schoolId);
            _message = $"Report submitted for approval. Status: {result.Status}.";
            _report = new ClassPerformanceReportEntity
            {
                ReportPeriod = _report.ReportPeriod,
                Term = _report.Term,
                AcademicYear = _report.AcademicYear,
                WeekNumber = _report.WeekNumber,
                MonthNumber = _report.MonthNumber
            };
            await LoadClassStudents();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static int WeekOfMonth(DateTime date) => ((date.Day - 1) / 7) + 1;
}
