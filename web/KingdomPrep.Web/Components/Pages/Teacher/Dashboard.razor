@page "/teacher/dashboard"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Teacher")]
@using KingdomPrep.Web.Data
@using KingdomPrep.Web.Data.Entities
@inject ITeacherPortalRepository TeacherRepo
@inject NavigationManager NavManager
@inject IPortalTenantContext TenantContext

<PageTitle>Teacher Dashboard - Nyansapo ERP</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-primary" style="font-weight: 700; font-family: 'Georgia', serif;">Teacher Dashboard</h2>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-6 mb-3">
                <KpCard Variant="KpCard.CardVariant.Default">
                    <Body>
                        <h5 class="text-muted text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.05em;">Assigned Classes</h5>
                        <h2 class="mb-0 text-primary fw-bold">@_assignedClasses.Count</h2>
                    </Body>
                </KpCard>
            </div>
            <div class="col-md-6 mb-3">
                <KpCard Variant="KpCard.CardVariant.Default">
                    <Body>
                        <h5 class="text-muted text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.05em;">Total Students</h5>
                        <h2 class="mb-0 text-primary fw-bold">@_totalStudents</h2>
                    </Body>
                </KpCard>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8 mb-4">
                <KpCard Variant="KpCard.CardVariant.Default" Class="h-100">
                    <Body>
                        <h4 class="text-primary mb-3">My Classes</h4>
                        @if (_assignedClasses.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Class Name</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in _assignedClasses)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@c.ClassName</td>
                                                <td class="text-end">
                                                    <a href="teacher/attendance?class=@Uri.EscapeDataString(c.ClassName)" class="btn btn-sm btn-outline-primary">Attendance</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">You have no assigned classes.</div>
                        }
                    </Body>
                </KpCard>
            </div>

            <div class="col-lg-4 mb-4">
                <KpCard Variant="KpCard.CardVariant.Default" Class="h-100">
                    <Body>
                        <h4 class="text-primary mb-3">Recent Assignments</h4>
                        @if (_recentAssignments.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var a in _recentAssignments)
                                {
                                    <li class="list-group-item px-0 py-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="mb-1 fw-bold text-dark">@a.Title</h6>
                                                <small class="text-muted">@a.ClassID • Due: @a.DueDate.ToShortDateString()</small>
                                            </div>
                                            <span class="badge bg-light text-dark border">@a.Subject</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No recent assignments.</p>
                        }

                        <div class="mt-3 text-center">
                            <a href="teacher/assignments" class="btn btn-sm btn-outline-secondary w-100">View All</a>
                        </div>
                    </Body>
                </KpCard>
            </div>
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private int _employmentId;
    private Guid? _schoolId;

    private List<ClassAssignmentEntity> _assignedClasses = new();
    private List<AssignmentEntity> _recentAssignments = new();
    private int _totalStudents;

    protected override async Task OnInitializedAsync()
    {
        var tenant = await TenantContext.GetCurrentAsync();
        if (tenant.EmploymentId.HasValue)
        {
            _employmentId = tenant.EmploymentId.Value;
        }
        else
        {
            NavManager.NavigateTo("/login");
            return;
        }

        _schoolId = tenant.SchoolId;

        _assignedClasses = await TeacherRepo.GetAssignedClassesAsync(_employmentId, _schoolId);

        if (_assignedClasses.Any())
        {
            var classNames = _assignedClasses.Select(c => c.ClassName).ToList();
            _totalStudents = await TeacherRepo.GetStudentCountForClassesAsync(classNames, _schoolId);
        }

        _recentAssignments = await TeacherRepo.GetRecentAssignmentsAsync(_employmentId, 5, _schoolId);

        _isLoading = false;
    }
}
