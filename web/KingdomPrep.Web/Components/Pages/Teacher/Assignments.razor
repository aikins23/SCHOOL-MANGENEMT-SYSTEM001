@page "/teacher/assignments"
@rendermode InteractiveServer
@attribute [Authorize(Policy = WebPermission.TeacherAssignmentsManage)]
@using KingdomPrep.Web.Data
@using KingdomPrep.Web.Data.Entities
@inject ITeacherPortalRepository TeacherRepo
@inject IGradingPortalRepository GradingRepo
@inject NavigationManager NavManager
@inject IPortalTenantContext TenantContext

<PageTitle>Assignments - Nyansapo ERP</PageTitle>

<div class="container-fluid py-4" style="background-color: #f6f8fb; min-height: calc(100vh - 5rem);">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1" style="font-weight: 600; color: #11233a; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 2rem;">Assignments</h2>
            <p class="mb-0 text-muted" style="font-size: 0.95rem;">Manage homework and class assignments</p>
        </div>
        <div class="mt-2 mt-md-0">
            @if (!_showCreateForm)
            {
                <button class="btn text-white fw-semibold px-4 shadow-sm" style="background-color: #11233a; border-radius: 4px;" @onclick="ToggleForm">
                    + New Assignment
                </button>
            }
        </div>
    </div>

    @if (_showCreateForm)
    {
        <div class="card border-0 mb-4 shadow-sm" style="border-radius: 8px;">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <h5 class="mb-0" style="color: #11233a; font-weight: 600;">@(_editingAssignment.AssignmentID == 0 ? "Create New Assignment" : "Edit Assignment")</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted mb-1" style="font-size: 0.85rem;">Title</label>
                        <input type="text" class="form-control" placeholder="e.g. Algebra Chapter 2 Exercises" @bind="_editingAssignment.Title" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted mb-1" style="font-size: 0.85rem;">Subject</label>
                        <select class="form-select" @bind="_editingAssignment.Subject">
                            <option value="">-- Select Subject --</option>
                            @foreach (var sub in _subjects) { <option value="@sub">@sub</option> }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted mb-1" style="font-size: 0.85rem;">Class</label>
                        <select class="form-select" @bind="_editingAssignment.ClassID" @bind:after="LoadSubjectsForAssignmentClass">
                            <option value="">-- Select Class --</option>
                            @foreach (var c in _assignedClasses) { <option value="@c.ClassName">@c.ClassName</option> }
                        </select>
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted mb-1" style="font-size: 0.85rem;">Due Date</label>
                        <input type="date" class="form-control" @bind="_editingAssignment.DueDate" />
                    </div>
                    <div class="col-md-9">
                        <label class="form-label fw-semibold text-muted mb-1" style="font-size: 0.85rem;">Instructions / Description</label>
                        <textarea class="form-control" rows="2" placeholder="Write detailed instructions here..." @bind="_editingAssignment.Description"></textarea>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-light fw-semibold px-4" @onclick="ToggleForm" style="color: #475569;">Cancel</button>
                    <button class="btn text-white fw-semibold px-4" style="background-color: #16a34a;" @onclick="SaveAssignment" disabled="@_isSaving">
                        @if (_isSaving) { <span class="spinner-border spinner-border-sm"></span> } else { <span>Save Assignment</span> }
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
    }
    else if (!_assignments.Any())
    {
        <div class="text-center text-muted py-5 mt-4 bg-white rounded shadow-sm border-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3" style="color: #94a3b8;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            <h5>No Assignments Found</h5>
            <p>You haven't created any assignments yet. Click "+ New Assignment" to get started.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var assignment in _assignments)
            {
                var isOverdue = assignment.DueDate.Date < DateTime.Today;
                var dueColor = isOverdue ? "#dc2626" : "#f59e0b"; // Red if overdue, amber if pending

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm position-relative overflow-hidden" style="border-radius: 8px;">
                        <div style="position: absolute; top: 0; left: 0; right: 0; height: 4px; background-color: @(isOverdue ? "#f87171" : "#1e3a5f");"></div>
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge" style="background-color: #f1f5f9; color: #475569; font-weight: 600;">@assignment.Subject</span>
                                <span class="fw-bold" style="color: #1e40af; font-size: 0.85rem;">@assignment.ClassID</span>
                            </div>

                            <h5 class="fw-bold mb-2" style="color: #11233a;">@assignment.Title</h5>
                            <p class="text-muted mb-4" style="font-size: 0.9rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrWhiteSpace(assignment.Description) ? "No description provided." : assignment.Description)
                            </p>

                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="@dueColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                    <span class="fw-semibold" style="font-size: 0.85rem; color: @dueColor;">Due: @assignment.DueDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-light" @onclick="() => EditAssignment(assignment)" title="Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="16 3 21 8 8 21 3 21 3 16 16 3"></polygon></svg>
                                    </button>
                                    <button class="btn btn-sm" style="background-color: #fee2e2; color: #dc2626;" @onclick="() => DeleteAssignment(assignment.AssignmentID)" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _showCreateForm = false;
    private bool _isSaving = false;

    private int _employmentId;
    private Guid? _schoolId;
    private List<ClassAssignmentEntity> _assignedClasses = new();
    private List<string> _subjects = new();
    private List<AssignmentEntity> _assignments = new();

    private AssignmentEntity _editingAssignment = new AssignmentEntity { DueDate = DateTime.Today.AddDays(7) };

    protected override async Task OnInitializedAsync()
    {
        var tenant = await TenantContext.GetCurrentAsync();
        if (!tenant.EmploymentId.HasValue)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        _employmentId = tenant.EmploymentId.Value;
        _schoolId = tenant.SchoolId;

        _assignedClasses = await TeacherRepo.GetAssignedClassesAsync(_employmentId, _schoolId);
        _subjects = await GradingRepo.GetSubjectsAsync(_assignedClasses.FirstOrDefault()?.ClassName, _schoolId);

        await LoadAssignments();
    }

    private async Task LoadAssignments()
    {
        _isLoading = true;
        _assignments = await TeacherRepo.GetAllAssignmentsAsync(_employmentId, _schoolId);
        _isLoading = false;
    }

    private async Task ToggleForm()
    {
        _showCreateForm = !_showCreateForm;
        if (_showCreateForm)
        {
            _editingAssignment = new AssignmentEntity
            {
                TeacherID = _employmentId.ToString(),
                DueDate = DateTime.Today.AddDays(7),
                ClassID = _assignedClasses.FirstOrDefault()?.ClassName ?? ""
            };
            await LoadSubjectsForAssignmentClass();
        }
    }

    private async Task EditAssignment(AssignmentEntity assignment)
    {
        _editingAssignment = new AssignmentEntity
        {
            AssignmentID = assignment.AssignmentID,
            Title = assignment.Title,
            Description = assignment.Description,
            ClassID = assignment.ClassID,
            Subject = assignment.Subject,
            DueDate = assignment.DueDate,
            TeacherID = assignment.TeacherID,
            CreatedDate = assignment.CreatedDate
        };
        _showCreateForm = true;
        await LoadSubjectsForAssignmentClass();
    }

    private async Task LoadSubjectsForAssignmentClass()
    {
        _subjects = await GradingRepo.GetSubjectsAsync(_editingAssignment.ClassID, _schoolId);
        if (!string.IsNullOrWhiteSpace(_editingAssignment.Subject) && !_subjects.Contains(_editingAssignment.Subject))
        {
            _editingAssignment.Subject = "";
        }
    }

    private async Task SaveAssignment()
    {
        if (string.IsNullOrWhiteSpace(_editingAssignment.Title) || string.IsNullOrWhiteSpace(_editingAssignment.Subject) || string.IsNullOrWhiteSpace(_editingAssignment.ClassID))
        {
            return; // Basic validation
        }

        _isSaving = true;
        _editingAssignment.TeacherID = _employmentId.ToString();
        await TeacherRepo.SaveAssignmentAsync(_editingAssignment, _schoolId);

        _showCreateForm = false;
        _isSaving = false;
        await LoadAssignments();
    }

    private async Task DeleteAssignment(int id)
    {
        // Ideally show a confirmation dialog, but keeping it simple for now
        await TeacherRepo.DeleteAssignmentAsync(id, _employmentId, _schoolId);
        await LoadAssignments();
    }
}
