@page "/finance/expenses"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator,Accountant,Director")]
@using KingdomPrep.Web.Data
@using KingdomPrep.Web.Data.Entities
@inject IFinancePortalRepository FinanceRepo
@inject IPortalTenantContext TenantContext

<PageTitle>Expense Register - Nyansapo ERP</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1 fw-bold" style="color: #0b1f48;">Expense Register</h2>
            <p class="text-muted mb-0">Track recorded expenses by purpose, payee, and date.</p>
        </div>
        <AuthorizeView Policy="@WebPermission.ExpenseManage">
            <Authorized>
                <a class="btn btn-danger fw-semibold" href="finance/record-expense">Record Expense</a>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted text-uppercase fw-semibold small mb-2">Filtered Expenses</div>
                    <div class="fs-3 fw-bold">@_result.TotalCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted text-uppercase fw-semibold small mb-2">Total Spent</div>
                    <div class="fs-3 fw-bold" style="color: #dc2626;">@Money(_result.TotalAmount)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4">
                    <label class="form-label fw-semibold text-muted">Search</label>
                    <input class="form-control" placeholder="Name, purpose, payee, or authorizer" @bind="_searchTerm" @bind:event="oninput" />
                </div>
                <div class="col-sm-6 col-lg-2">
                    <label class="form-label fw-semibold text-muted">From</label>
                    <input type="date" class="form-control" value="@_fromText" @onchange="e => _fromText = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="col-sm-6 col-lg-2">
                    <label class="form-label fw-semibold text-muted">To</label>
                    <input type="date" class="form-control" value="@_toText" @onchange="e => _toText = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="col-lg-4 d-flex gap-2 justify-content-lg-end">
                    <button class="btn btn-primary fw-semibold px-4" @onclick="ApplyFilters" disabled="@_isLoading">Apply</button>
                    <button class="btn btn-light fw-semibold px-4" @onclick="ClearFilters" disabled="@_isLoading">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Expense</th>
                            <th>Purpose</th>
                            <th>Payee</th>
                            <th>Authorized By</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_isLoading)
                        {
                            <tr><td colspan="6" class="text-center py-4"><span class="spinner-border spinner-border-sm"></span></td></tr>
                        }
                        else if (!_result.Items.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No expenses found.</td></tr>
                        }
                        else
                        {
                            @foreach (var expense in _result.Items)
                            {
                                <tr>
                                    <td>@expense.Date.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div class="fw-semibold">@expense.ExpenseName</div>
                                        @if (!string.IsNullOrWhiteSpace(expense.Description))
                                        {
                                            <div class="small text-muted">@expense.Description</div>
                                        }
                                    </td>
                                    <td>@expense.Purpose</td>
                                    <td>@(expense.Payee ?? "-")</td>
                                    <td>@(expense.Payer ?? "-")</td>
                                    <td class="text-end fw-bold" style="color: #dc2626;">@Money(ExpenseAmount(expense))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="text-muted small">Page @_page of @TotalPages</div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousPage" disabled="@(_page <= 1 || _isLoading)">Previous</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(_page >= TotalPages || _isLoading)">Next</button>
            </div>
        </div>
    </div>
</div>

@code {
    private const int PageSize = 20;
    private FinanceExpenseRegisterResult _result = new(new List<ExpenseEntity>(), 0, 0m);
    private string _searchTerm = "";
    private string _fromText = "";
    private string _toText = "";
    private int _page = 1;
    private bool _isLoading;
    private Guid? _schoolId;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_result.TotalCount / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        _schoolId = (await TenantContext.GetCurrentAsync()).SchoolId;
        await LoadAsync();
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearFilters()
    {
        _searchTerm = "";
        _fromText = "";
        _toText = "";
        _page = 1;
        await LoadAsync();
    }

    private async Task PreviousPage()
    {
        if (_page <= 1) return;
        _page--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (_page >= TotalPages) return;
        _page++;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _result = await FinanceRepo.GetExpenseRegisterAsync(_searchTerm, ParseDate(_fromText), ParseDate(_toText), _page, PageSize, _schoolId);
        _isLoading = false;
    }

    private static DateTime? ParseDate(string value) =>
        DateTime.TryParse(value, out var parsed) ? parsed.Date : null;

    private static decimal ExpenseAmount(ExpenseEntity expense) =>
        decimal.TryParse(expense.Amount, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var parsed) ? parsed : 0m;

    private static string Money(decimal amount) =>
        amount.ToString("C2", new System.Globalization.CultureInfo("en-GH"));
}
