@page "/headmaster"
@using KingdomPrep.Web.Data
@inject IHeadmasterService HeadmasterService
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator,Headmaster,Director")]
@rendermode InteractiveServer

<PageTitle>Headmaster Dashboard - Nyansapo</PageTitle>

<div class="headmaster-portal">
    <div class="portal-header mb-4">
        <h2 class="fw-bold mb-1" style="color: var(--nyansapo-navy);">Headmaster Overview</h2>
        <p class="text-muted">Centralized monitoring and approval dashboard.</p>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-4 gap-2 portal-tabs" id="headmaster-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeTab == "overview" ? "active" : "")" @onclick='() => SetTab("overview")'>
                <i class="bi bi-grid-1x2"></i> Overview
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeTab == "approvals" ? "active" : "")" @onclick='() => SetTab("approvals")'>
                <i class="bi bi-check-circle"></i> Approvals
                @if(_stats?.PendingApprovalsCount > 0)
                {
                    <span class="badge bg-danger rounded-pill ms-2">@_stats.PendingApprovalsCount</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeTab == "students" ? "active" : "")" @onclick='() => SetTab("students")'>
                <i class="bi bi-people"></i> Students
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeTab == "staff" ? "active" : "")" @onclick='() => SetTab("staff")'>
                <i class="bi bi-person-badge"></i> Staff
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(_activeTab == "finance" ? "active" : "")" @onclick='() => SetTab("finance")'>
                <i class="bi bi-pie-chart"></i> Finance
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content mt-4">
        @if (_isLoading)
        {
            <div class="d-flex justify-content-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (_stats != null)
        {
            <!-- OVERVIEW TAB -->
            <div class="tab-pane fade @(_activeTab == "overview" ? "show active" : "")">

                <!-- KPI Cards Grid -->
                <div class="row g-4 mb-4">
                    <!-- Students Card -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 kpi-card">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="text-muted fw-bold mb-0 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Total Students</h6>
                                <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-mortarboard-fill fs-5"></i>
                                </div>
                            </div>
                            <h3 class="fw-bold mb-1">@_stats.TotalStudents.ToString("N0")</h3>
                            <span class="badge bg-success bg-opacity-10 text-success fw-semibold"><i class="bi bi-arrow-up-short"></i> Active</span>
                        </div>
                    </div>

                    <!-- Staff Card -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 kpi-card">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="text-muted fw-bold mb-0 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Total Teachers</h6>
                                <div class="icon-box bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-person-workspace fs-5"></i>
                                </div>
                            </div>
                            <h3 class="fw-bold mb-1">@_stats.TotalTeachers.ToString("N0")</h3>
                            <span class="text-muted" style="font-size: 0.8rem;">Across @_stats.TotalClasses Classes</span>
                        </div>
                    </div>

                    <!-- Attendance Card -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 kpi-card">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="text-muted fw-bold mb-0 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Daily Attendance</h6>
                                <div class="icon-box bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-calendar2-check-fill fs-5"></i>
                                </div>
                            </div>
                            <h3 class="fw-bold mb-1">@_stats.StudentAttendancePercentage%</h3>
                            <div class="progress mt-2" style="height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @(_stats.StudentAttendancePercentage)%" aria-valuenow="@_stats.StudentAttendancePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Fee Collection Card (PERCENTAGE ONLY) -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 kpi-card">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="text-muted fw-bold mb-0 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Fee Collection Rate</h6>
                                <div class="icon-box bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-pie-chart-fill fs-5"></i>
                                </div>
                            </div>
                            <h3 class="fw-bold mb-1">@_stats.FeesPaidPercentage%</h3>
                            <div class="d-flex justify-content-between text-muted mt-2" style="font-size: 0.75rem;">
                                <span>Paid</span>
                                <span>Outstanding: @_stats.FeesOutstandingPercentage%</span>
                            </div>
                            <div class="progress mt-1" style="height: 6px;">
                                <div class="progress-bar bg-warning" role="progressbar" style="width: @(_stats.FeesPaidPercentage)%" aria-valuenow="@_stats.FeesPaidPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Secondary Row -->
                <div class="row g-4">
                    <!-- Pending Approvals Widget -->
                    <div class="col-12 col-lg-8">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-header bg-white border-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                                <h5 class="fw-bold mb-0">Pending Workflow Approvals</h5>
                                <button class="btn btn-sm btn-light rounded-pill px-3" @onclick='() => SetTab("approvals")'>View All</button>
                            </div>
                            <div class="card-body px-4">
                                @if (_pendingApprovals != null && _pendingApprovals.Any())
                                {
                                    <div class="list-group list-group-flush gap-2">
                                        @foreach(var item in _pendingApprovals.Take(4))
                                        {
                                            <div class="list-group-item border-0 rounded-3 bg-light p-3 d-flex justify-content-between align-items-center">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-2 d-flex align-items-center justify-content-center">
                                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="fw-bold mb-1">@item.Type</h6>
                                                        <p class="text-muted mb-0" style="font-size: 0.85rem;">@item.Description</p>
                                                    </div>
                                                </div>
                                                @if (item.Type == "Performance Report")
                                                {
                                                    <a class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" href="headmaster/performance-approvals">Review</a>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">Review</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-5">
                                        <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                                        <p class="text-muted mt-3">All caught up! No pending approvals.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions / Announcements -->
                    <div class="col-12 col-lg-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(135deg, var(--nyansapo-navy) 0%, #1e1b4b 100%); color: white;">
                            <div class="card-body p-4 d-flex flex-column">
                                <h5 class="fw-bold mb-4">Quick Communication</h5>
                                <p class="opacity-75" style="font-size: 0.9rem;">Broadcast an announcement to Parents, Teachers, or the whole school instantly.</p>

                                <textarea class="form-control rounded-3 border-0 bg-white bg-opacity-10 text-white placeholder-light mb-3" rows="3" placeholder="Write announcement..."></textarea>

                                <div class="mt-auto">
                                    <button class="btn btn-warning w-100 fw-bold rounded-pill shadow-sm">Send Broadcast</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- APPROVALS TAB -->
            <div class="tab-pane fade @(_activeTab == "approvals" ? "show active" : "")">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 p-4">
                        <h5 class="fw-bold mb-0">Workflow Inbox</h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 border-0">Request Type</th>
                                    <th class="border-0">Description</th>
                                    <th class="border-0">Date Submitted</th>
                                    <th class="border-0 text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_pendingApprovals != null && _pendingApprovals.Any())
                                {
                                    foreach (var item in _pendingApprovals)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-semibold">
                                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">@item.Type</span>
                                            </td>
                                            <td>@item.Description</td>
                                            <td class="text-muted">@item.DateSubmitted.ToString("MMM dd, yyyy")</td>
                                            <td class="text-end pe-4">
                                                @if (item.Type == "Performance Report")
                                                {
                                                    <a class="btn btn-sm btn-outline-primary rounded-pill" href="headmaster/performance-approvals">Open Review</a>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-success rounded-pill me-2"><i class="bi bi-check-lg"></i> Approve</button>
                                                    <button class="btn btn-sm btn-outline-danger rounded-pill"><i class="bi bi-x-lg"></i> Deny</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- STUDENTS TAB (Mock Scaffold) -->
            <div class="tab-pane fade @(_activeTab == "students" ? "show active" : "")">
                <div class="alert alert-info rounded-4 border-0 shadow-sm">
                    <h5 class="alert-heading fw-bold"><i class="bi bi-info-circle-fill me-2"></i> Student Management Module</h5>
                    <p>This section is designed to display a comprehensive list of all students, track disciplinary records, and approve admissions.</p>
                    <hr>
                    <p class="mb-0">Module implementation ready for expansion based on Functional Specifications.</p>
                </div>
            </div>

            <!-- STAFF TAB (Mock Scaffold) -->
            <div class="tab-pane fade @(_activeTab == "staff" ? "show active" : "")">
                <div class="alert alert-primary rounded-4 border-0 shadow-sm">
                    <h5 class="alert-heading fw-bold"><i class="bi bi-person-badge-fill me-2"></i> Teacher & Staff Management Module</h5>
                    <p>Monitor teacher workload distribution, track punctuality, and review performance metrics here.</p>
                </div>
            </div>

            <!-- FINANCE TAB -->
            <div class="tab-pane fade @(_activeTab == "finance" ? "show active" : "")">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">Financial Health (Percentage Abstract)</h5>

                        <div class="row align-items-center">
                            <div class="col-md-6 text-center">
                                <!-- Donut Chart Mockup using CSS Conic Gradient -->
                                <div class="position-relative d-inline-flex align-items-center justify-content-center mx-auto"
                                     style="width: 200px; height: 200px; border-radius: 50%; background: conic-gradient(var(--nyansapo-success) @(_stats.FeesPaidPercentage)%, var(--nyansapo-danger) 0);">
                                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center flex-column" style="width: 150px; height: 150px;">
                                        <h2 class="fw-bold mb-0 text-success">@_stats.FeesPaidPercentage%</h2>
                                        <span class="text-muted fw-semibold" style="font-size: 0.8rem;">Collected</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mt-4 mt-md-0">
                                <h6 class="fw-bold mb-3">Collection Breakdown</h6>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted fw-semibold"><i class="bi bi-circle-fill text-success me-2"></i> Successfully Collected</span>
                                    <span class="fw-bold">@_stats.FeesPaidPercentage%</span>
                                </div>
                                <div class="d-flex justify-content-between mb-4">
                                    <span class="text-muted fw-semibold"><i class="bi bi-circle-fill text-danger me-2"></i> Outstanding Debt</span>
                                    <span class="fw-bold">@_stats.FeesOutstandingPercentage%</span>
                                </div>

                                <div class="alert alert-warning border-0 rounded-3 mb-0" style="font-size: 0.85rem;">
                                    <i class="bi bi-shield-lock-fill me-1"></i> As per system security protocols, Headmaster accounts display aggregate financial health via percentages only. Raw transaction amounts are restricted.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .portal-tabs .nav-link {
        color: var(--nyansapo-navy);
        font-weight: 600;
        border-radius: 99px;
        padding: 0.6rem 1.2rem;
        transition: all 0.2s ease;
    }

    .portal-tabs .nav-link:hover {
        background: rgba(0,0,0,0.05);
    }

    .portal-tabs .nav-link.active {
        background: #4f46e5 !important;
        color: white;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.3);
    }

    .kpi-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 15px rgba(0,0,0,0.05) !important;
    }

    .placeholder-light::placeholder {
        color: rgba(255,255,255,0.6);
    }
</style>

@code {
    private string _activeTab = "overview";
    private bool _isLoading = true;
    private HeadmasterDashboardStatsDto? _stats;
    private List<ApprovalItemDto>? _pendingApprovals;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;

        try
        {
            _stats = await HeadmasterService.GetDashboardOverviewAsync();
            _pendingApprovals = await HeadmasterService.GetPendingApprovalsAsync();
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error loading headmaster dashboard: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
    }
}
