@page "/"
@attribute [Authorize]
@inject IStudentStats Stats
@inject IWardRepository WardRepo

<PageTitle>Dashboard - Kingdom Preparatory</PageTitle>

<AuthorizeView>
    <Authorized Context="auth">
        <h1>Welcome, @auth.User.Identity?.Name</h1>
        <p>Signed in as <strong>@RoleName(auth)</strong></p>

        @if (RoleName(auth) == "Parent")
        {
            @if (_ward != null)
            {
                <div class="dash-cards">
                    <div class="dash-card">
                        <h3>My Ward</h3>
                        <p><strong>Name:</strong> @_ward.FullName</p>
                        <p><strong>ID:</strong> @_ward.StudentID</p>
                        <p><strong>Class:</strong> @_ward.ClassID</p>
                    </div>
                    <div class="dash-card disabled">Terminal Report (coming soon)</div>
                    <div class="dash-card disabled">Attendance Records (coming soon)</div>
                    <div class="dash-card disabled">Fee Ledger (coming soon)</div>
                </div>
            }
            else
            {
                <p>Your account is not yet linked to a student. Please contact the administrator.</p>
            }
        }
        else
        {
            <div class="dash-cards">
                <div class="dash-card">Students: <strong>@_studentCount</strong></div>
                <div class="dash-card disabled">Academic progress (coming soon)</div>
                <div class="dash-card disabled">Attendance (coming soon)</div>
                <div class="dash-card disabled">HR &amp; Leave (coming soon)</div>
            </div>
        }

        <form method="post" action="/logout" class="mt-3">
            <button type="submit">Sign out</button>
        </form>
    </Authorized>
</AuthorizeView>

@code {
    private int _studentCount;
    private KingdomPrep.Web.Data.Entities.StudentEntity? _ward;

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        var user = authState.User;
        
        if (user.IsInRole("Parent"))
        {
            var empIdStr = user.FindFirst("EmploymentId")?.Value;
            if (int.TryParse(empIdStr, out int studentId))
            {
                _ward = await WardRepo.GetWardAsync(studentId);
            }
        }
        else
        {
            _studentCount = await Stats.CountAsync();
        }
    }

    private static string RoleName(AuthenticationState s)
        => s.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
}
