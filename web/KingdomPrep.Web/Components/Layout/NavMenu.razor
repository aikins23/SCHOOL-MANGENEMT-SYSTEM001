@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using KingdomPrep.Web.Data
@inject ISchoolProfileService SchoolProfileService

<div class="brand-section position-relative">
    @if (!string.IsNullOrEmpty(_schoolLogoBase64))
    {
        <img src="data:image/png;base64,@_schoolLogoBase64" alt="School Logo" class="brand-badge-mini me-2" style="object-fit: contain; background: transparent; box-shadow: none;" />
    }
    else
    {
        <div class="brand-badge-mini me-2">@_schoolInitials</div>
    }
    <div class="brand-copy d-flex flex-column">
        <span class="brand-display-name">@_schoolName</span>
        <span class="brand-sub-name">School Portal</span>
    </div>
    <label for="sidebar-toggler" class="sidebar-mobile-close" title="Close menu" aria-label="Close menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
        </svg>
    </label>
</div>

