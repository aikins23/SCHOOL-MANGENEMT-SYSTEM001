@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal? _user;
    private string _schoolName = SchoolBranding.ProductName;
    private string _schoolInitials = SchoolBranding.Initials(SchoolBranding.ProductName);
    private string? _schoolLogoBase64 = null;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        _user = authState?.User;

        var profile = await SchoolProfileService.GetSchoolProfileAsync();
        if (profile != null)
        {
            if (!string.IsNullOrWhiteSpace(profile.Name))
            {
                _schoolName = SchoolBranding.DisplayName(profile);
                _schoolInitials = SchoolBranding.Initials(profile);
            }
            if (profile.Logo != null && profile.Logo.Length > 0)
            {
                _schoolLogoBase64 = Convert.ToBase64String(profile.Logo);
            }
        }
    }

    private bool IsInRole(string role) => _user?.IsInRole(role) ?? false;
    private bool IsAdmin => IsInRole("Administrator");
    private bool IsHead => IsInRole("Headmaster");
    private bool IsDirector => IsInRole("Director");
    private bool IsAccountant => IsInRole("Accountant");
    private bool IsTeacher => IsInRole("Teacher");
    private bool IsParent => IsInRole("Parent");
    private bool IsStaff => IsAdmin || IsHead || IsDirector || IsAccountant || IsTeacher;
    private bool CanRecordFee => HasPermission(WebPermission.FeePaymentRecord);
    private bool CanRecordExpense => HasPermission(WebPermission.ExpenseManage);
    private bool CanManageAdmissions => HasPermission(WebPermission.AdmissionsManage);
    private bool CanManageExamSetup => HasPermission(WebPermission.SettingsExamSetupManage);
    private bool CanManageParentRequests => HasPermission(WebPermission.AdminUsersManage);

    private bool HasPermission(string policyName) => WebPermission.CanRenderAction(_user, policyName);

    private string GetUserRole()
    {
        return _user?.FindFirst(ClaimTypes.Role)?.Value ?? "User";
    }

    private string GetUserInitial()
    {
        var name = _user?.Identity?.Name;
        return string.IsNullOrWhiteSpace(name) ? "U" : name[0].ToString().ToUpper();
    }
}
