    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.toggleTheme = function() {
            var root = document.documentElement;
            if (root.getAttribute('data-theme') === 'dark') {
                root.removeAttribute('data-theme');
                localStorage.setItem('theme', 'light');
            } else {
                root.setAttribute('data-theme', 'dark');
                localStorage.setItem('theme', 'dark');
            }
        };

        if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
        }

        window.downloadPdfFromBase64 = function(fileName, base64) {
            var link = document.createElement('a');
            link.download = fileName;
            link.href = 'data:application/pdf;base64,' + base64;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };

        window.downloadFileFromStream = async function(fileName, contentStreamReference) {
            const arrayBuffer = await contentStreamReference.arrayBuffer();
            const blob = new Blob([arrayBuffer]);
            const url = URL.createObjectURL(blob);
            const anchorElement = document.createElement('a');
            anchorElement.href = url;
            anchorElement.download = fileName ?? '';
            anchorElement.click();
            anchorElement.remove();
            URL.revokeObjectURL(url);
        };

        window.payWithPaystack = function(email, amount, reference, publicKey, dotNetHelper) {
            if (!window.PaystackPop || !window.PaystackPop.setup) {
                throw new Error('Paystack checkout script is not loaded. Check internet access, ad blockers, or the Paystack script URL.');
            }

            var handler = PaystackPop.setup({
                key: publicKey,
                email: email,
                amount: Math.round(Number(amount) * 100), // in pesewas
                ref: reference,
                callback: function(response) {
                    dotNetHelper.invokeMethodAsync('OnPaymentSuccess', response.reference);
                },
                onClose: function() {
                    dotNetHelper.invokeMethodAsync('OnPaymentClosed');
                }
            });
            handler.openIframe();
        };

        // Ensure Profile Data is strictly persisted on every page load instantly
        window.saveProfileData = function(email, phone, avatar) {
            if(email) localStorage.setItem('user_email', email);
            if(phone) localStorage.setItem('user_phone', phone);
            if(avatar) localStorage.setItem('user_avatar', avatar);
            window.applyProfileData();
        };

        window.applyProfileData = function() {
            var email = localStorage.getItem('user_email');
            var phone = localStorage.getItem('user_phone');
            var avatar = localStorage.getItem('user_avatar');

            if (email) {
                document.querySelectorAll('.profile-username-display').forEach(el => el.textContent = email);
                document.querySelectorAll('.profile-initial-display').forEach(el => el.textContent = email.charAt(0).toUpperCase());
            }
            if (phone) {
                document.querySelectorAll('.profile-phone-display').forEach(el => el.textContent = phone);
            }
            if (avatar) {
                document.querySelectorAll('.profile-avatar-display').forEach(el => {
                    el.innerHTML = '<img src="' + avatar + '" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />';
                });
            }
        };

        window.initializeNyansapoSidebar = function() {
            if (window.__nyansapoSidebarReady) return;
            window.__nyansapoSidebarReady = true;

            var autoMin = 1180;
            var autoMax = 1360;

            function sidebarToggle() {
                return document.getElementById('sidebar-toggler');
            }

            function isDesktop() {
                return window.matchMedia('(min-width: 641px)').matches;
            }

            function setCollapsed(collapsed) {
                var toggle = sidebarToggle();
                if (toggle) toggle.checked = collapsed;
            }

            function applyResponsiveState() {
                var toggle = sidebarToggle();
                if (!toggle) return;

                if (!isDesktop()) {
                    toggle.checked = false;
                    return;
                }

                if (sessionStorage.getItem('nyansapo-sidebar-manual') === '1') return;

                if (window.innerWidth <= autoMin) {
                    toggle.checked = true;
                } else if (window.innerWidth >= autoMax) {
                    toggle.checked = false;
                }
            }

            function sections() {
                return Array.prototype.slice.call(document.querySelectorAll('.nav-scrollable details.nav-section'));
            }

            function syncActiveSection() {
                var items = sections();
                if (items.length === 0) return;

                if (!isDesktop()) {
                    items.forEach(function(section) {
                        section.open = false;
                    });
                    return;
                }

                var active = items.find(function(section) {
                    return section.querySelector('.nav-link.active');
                });

                items.forEach(function(section, index) {
                    section.open = active ? section === active : index === 0;
                });
            }

            document.addEventListener('click', function(event) {
                var summary = event.target.closest('.nav-scrollable .nav-group-title');
                if (summary) {
                    var section = summary.closest('details.nav-section');
                    if (!section) return;

                    event.preventDefault();
                    var nextOpen = !section.open;
                    sections().forEach(function(item) {
                        item.open = false;
                    });
                    section.open = nextOpen;
                    return;
                }

                var navLink = event.target.closest('.nav-scrollable .nav-link');
                if (navLink) {
                    if (!isDesktop()) setCollapsed(false);
                    window.setTimeout(syncActiveSection, 80);
                }

                var manualToggle = event.target.closest('label[for="sidebar-toggler"]');
                if (manualToggle && isDesktop()) {
                    sessionStorage.setItem('nyansapo-sidebar-manual', '1');
                }
            });

            window.addEventListener('resize', applyResponsiveState);
            document.addEventListener('DOMContentLoaded', function() {
                syncActiveSection();
                applyResponsiveState();
            });

            syncActiveSection();
            applyResponsiveState();
        };

        window.initializeNyansapoPwaInstall = function() {
            if (window.__nyansapoPwaInstallReady) return;
            window.__nyansapoPwaInstallReady = true;

            var installPromptEvent = null;
            var iosInstallMessage = 'To install Nyansapo ERP on iPhone: tap the Share button, then choose Add to Home Screen.';

            function isStandalone() {
                return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
            }

            function isIos() {
                return /iphone|ipad|ipod/i.test(window.navigator.userAgent || '');
            }

            function isAndroid() {
                return /android/i.test(window.navigator.userAgent || '');
            }

            function isSecureForPwa() {
                return location.protocol === 'https:' || location.hostname === 'localhost' || location.hostname === '127.0.0.1';
            }

            function button() {
                return document.getElementById('pwa-install-button');
            }

            function updateButton() {
                var btn = button();
                if (!btn) return;

                if (isStandalone()) {
                    btn.hidden = true;
                    return;
                }

                btn.hidden = !(installPromptEvent || isIos() || isSecureForPwa());
            }

            function waitForServiceWorkerReady(timeoutMs) {
                if (!('serviceWorker' in navigator)) {
                    return Promise.resolve({ ready: false, reason: 'not-supported' });
                }

                return Promise.race([
                    navigator.serviceWorker.ready.then(function(registration) {
                        return {
                            ready: !!(registration && registration.active),
                            registration: registration
                        };
                    }),
                    new Promise(function(resolve) {
                        window.setTimeout(function() {
                            resolve({ ready: false, reason: 'timeout' });
                        }, timeoutMs || 5000);
                    })
                ]);
            }

            async function getPwaReadiness() {
                var status = {
                    secure: isSecureForPwa(),
                    serviceWorkerSupported: 'serviceWorker' in navigator,
                    serviceWorkerReady: false,
                    serviceWorkerControlsPage: false,
                    manifestReady: false
                };

                if (status.secure && status.serviceWorkerSupported) {
                    var workerStatus = await waitForServiceWorkerReady(5000);
                    status.serviceWorkerReady = !!workerStatus.ready;
                    status.serviceWorkerControlsPage = !!navigator.serviceWorker.controller;
                }

                try {
                    var manifestResponse = await fetch('/manifest.json', { cache: 'no-store' });
                    if (manifestResponse.ok) {
                        var manifest = await manifestResponse.json();
                        status.manifestReady = !!(manifest.name && manifest.start_url && manifest.display && manifest.icons && manifest.icons.length);
                    }
                } catch { }

                return status;
            }

            function reloadOnceForServiceWorkerControl(status) {
                if (!status.secure || !status.serviceWorkerReady || status.serviceWorkerControlsPage) {
                    return false;
                }

                if (sessionStorage.getItem('nyansapo-pwa-control-reload') === '1') {
                    return false;
                }

                sessionStorage.setItem('nyansapo-pwa-control-reload', '1');
                alert('Nyansapo ERP is preparing install mode. The page will reload once; after it opens again, tap Install.');
                location.reload();
                return true;
            }

            window.addEventListener('beforeinstallprompt', function(event) {
                event.preventDefault();
                installPromptEvent = event;
                updateButton();
            });

            window.addEventListener('appinstalled', function() {
                installPromptEvent = null;
                localStorage.setItem('nyansapo-pwa-installed', '1');
                updateButton();
            });

            window.installNyansapoPwa = async function() {
                if (isStandalone()) {
                    updateButton();
                    return;
                }

                if (installPromptEvent) {
                    var promptEvent = installPromptEvent;
                    installPromptEvent = null;
                    promptEvent.prompt();

                    try {
                        await promptEvent.userChoice;
                    } catch { }

                    updateButton();
                    return;
                }

                if (isIos()) {
                    alert(iosInstallMessage);
                    return;
                }

                if (!isSecureForPwa()) {
                    alert('PWA install needs HTTPS. Open the app through the HTTPS Cloudflare/ngrok link on your phone, not a local http://192.168... address.');
                    return;
                }

                var status = await getPwaReadiness();

                if (reloadOnceForServiceWorkerControl(status)) {
                    return;
                }

                if (!status.serviceWorkerSupported) {
                    alert('This browser does not support installable web apps. Use Android Chrome or Microsoft Edge.');
                    return;
                }

                if (!status.serviceWorkerReady) {
                    alert('The offline app worker is still installing. Reload the HTTPS link once, wait a few seconds, then tap Install again.');
                    return;
                }

                if (!status.manifestReady) {
                    alert('The app manifest is not reachable yet. Reload the HTTPS link and try again. If this keeps happening, restart the web app and Cloudflare tunnel.');
                    return;
                }

                if (isAndroid()) {
                    alert('The PWA files are ready, but Chrome has not exposed the native install prompt yet. Tap Chrome menu > Install app. If it only says Add to Home screen, clear this site data, reload the HTTPS link, wait five seconds, and tap Install again.');
                    return;
                }

                alert('Use your browser menu and choose Install app. If you only see Add shortcut, reload once after the page finishes loading.');
            };

            window.__nyansapoPwaInstallUpdateButton = updateButton;
            document.addEventListener('DOMContentLoaded', updateButton);
            window.setTimeout(updateButton, 600);
        };

        // Run instantly on DOM Load
        document.addEventListener('DOMContentLoaded', window.applyProfileData);
        document.addEventListener('DOMContentLoaded', window.initializeNyansapoSidebar);
        document.addEventListener('DOMContentLoaded', window.initializeNyansapoPwaInstall);
    </script>
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/analytics.js"></script>
    <script>
        if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost' || location.hostname === '127.0.0.1')) {
            navigator.serviceWorker.register('/service-worker.js?v=3').then(function(registration) {
                console.log('PWA ServiceWorker registration successful with scope: ', registration.scope);
                registration.update();
                if (window.__nyansapoPwaInstallUpdateButton) {
                    window.__nyansapoPwaInstallUpdateButton();
                }
                navigator.serviceWorker.ready.then(function() {
                    if (window.__nyansapoPwaInstallUpdateButton) {
                        window.__nyansapoPwaInstallUpdateButton();
                    }
                });
            }).catch(function(err) {
                console.log('PWA ServiceWorker registration failed: ', err);
            });
        } else if ('serviceWorker' in navigator) {
            console.log('PWA ServiceWorker not registered because the page is not served from HTTPS or localhost.');
        }
    </script>
</body>

