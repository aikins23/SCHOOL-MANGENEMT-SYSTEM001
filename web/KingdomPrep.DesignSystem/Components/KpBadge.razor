@using Microsoft.AspNetCore.Components

<span class="@GetBadgeClass()" @attributes="@AdditionalAttributes">
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Primary;
    [Parameter] public BadgeSize Size { get; set; } = BadgeSize.Medium;
    [Parameter] public bool Pill { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    public enum BadgeVariant { Primary, Secondary, Success, Warning, Danger, Info, Light, Dark }
    public enum BadgeSize { Small, Medium, Large }

    private string GetBadgeClass()
    {
        var classes = new List<string> { "kp-badge" };

        classes.Add(Variant switch
        {
            BadgeVariant.Primary => "kp-badge-primary",
            BadgeVariant.Secondary => "kp-badge-secondary",
            BadgeVariant.Success => "kp-badge-success",
            BadgeVariant.Warning => "kp-badge-warning",
            BadgeVariant.Danger => "kp-badge-danger",
            BadgeVariant.Info => "kp-badge-info",
            BadgeVariant.Light => "kp-badge-light",
            BadgeVariant.Dark => "kp-badge-dark",
            _ => "kp-badge-primary"
        });

        classes.Add(Size switch
        {
            BadgeSize.Small => "kp-badge-sm",
            BadgeSize.Medium => "kp-badge-md",
            BadgeSize.Large => "kp-badge-lg",
            _ => "kp-badge-md"
        });

        if (Pill) classes.Add("kp-badge-pill");

        if (!string.IsNullOrWhiteSpace(Class)) classes.Add(Class);

        return string.Join(" ", classes);
    }
}
