@using Microsoft.AspNetCore.Components

<div class="kp-dropdown @GetDropdownClass()" @ref="DropdownRef" @onclick:stopPropagation="true">
    <button
        type="button"
        class="kp-dropdown-toggle"
        @onclick="@ToggleDropdown"
        @onkeydown="@OnKeyDown"
        aria-expanded="@IsOpen.ToString().ToLower()"
        aria-haspopup="listbox"
        aria-controls="@MenuId"
        disabled="@Disabled">
        <span class="kp-dropdown-label">
            @(SelectedItem?.Label ?? Placeholder)
        </span>
        <span class="kp-dropdown-arrow" aria-hidden="true">
            @(IsOpen ? "▲" : "▼")
        </span>
    </button>

    @if (IsOpen)
    {
        <div
            class="kp-dropdown-menu"
            id="@MenuId"
            role="listbox"
            @onkeydown="@OnMenuKeyDown"
            @ref="MenuRef">

            @if (ShowSearch)
            {
                <div class="kp-dropdown-search">
                    <input
                        type="text"
                        class="kp-dropdown-search-input"
                        placeholder="Search..."
                        @bind="@SearchText"
                        @bind:event="oninput"
                        @onkeydown="@OnSearchKeyDown" />
                </div>
            }

            <div class="kp-dropdown-items" role="presentation">
                @foreach (var item in FilteredItems)
                {
                    <button
                        type="button"
                        class="@GetItemClass(item)"
                        role="option"
                        aria-selected="@(SelectedItem == item)"
                        @onclick="@(() => SelectItem(item))"
                        @onmouseover="@(() => HighlightItem(item))">
                        @if (item.Icon != null)
                        {
                            <span class="kp-dropdown-item-icon" aria-hidden="true">@item.Icon</span>
                        }
                        <span class="kp-dropdown-item-label">@item.Label</span>
                        @if (item.Description != null)
                        {
                            <span class="kp-dropdown-item-description">@item.Description</span>
                        }
                    </button>
                }

                @if (FilteredItems.Count == 0 && ShowSearch)
                {
                    <div class="kp-dropdown-empty">No matching items</div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<DropdownItem> Items { get; set; } = new();
    [Parameter] public DropdownItem? SelectedItem { get; set; }
    [Parameter] public EventCallback<DropdownItem> SelectedItemChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select an option";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowSearch { get; set; } = false;
    [Parameter] public string? Class { get; set; }
    [Parameter] public DropdownPosition Position { get; set; } = DropdownPosition.Bottom;

    private bool IsOpen { get; set; }
    private string SearchText { get; set; } = "";
    private string MenuId => $"kp-dropdown-{Guid.NewGuid().ToString()[..8]}";
    private DropdownItem? HighlightedItem { get; set; }
    private ElementReference DropdownRef;
    private ElementReference MenuRef;

    public class DropdownItem
    {
        public string Label { get; set; } = "";
        public string? Value { get; set; }
        public string? Icon { get; set; }
        public string? Description { get; set; }
        public bool Disabled { get; set; }
    }

    public enum DropdownPosition { Bottom, Top, Left, Right }

    private List<DropdownItem> FilteredItems => Items.Where(i =>
        string.IsNullOrWhiteSpace(SearchText) ||
        i.Label.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
    ).ToList();

    private string GetDropdownClass()
    {
        var classes = new List<string>();
        if (!string.IsNullOrWhiteSpace(Class)) classes.Add(Class);
        return string.Join(" ", classes);
    }

    private string GetItemClass(DropdownItem item)
    {
        var classes = new List<string> { "kp-dropdown-item" };
        if (SelectedItem == item) classes.Add("kp-dropdown-item-selected");
        if (HighlightedItem == item) classes.Add("kp-dropdown-item-highlighted");
        if (item.Disabled) classes.Add("kp-dropdown-item-disabled");
        return string.Join(" ", classes);
    }

    private void ToggleDropdown()
    {
        if (Disabled) return;
        IsOpen = !IsOpen;
        if (IsOpen)
        {
            SearchText = "";
            HighlightedItem = SelectedItem;
        }
    }

    private async Task SelectItem(DropdownItem item)
    {
        if (item.Disabled) return;
        SelectedItem = item;
        await SelectedItemChanged.InvokeAsync(item);
        IsOpen = false;
    }

    private void HighlightItem(DropdownItem item)
    {
        if (!item.Disabled) HighlightedItem = item;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
            case " ":
                ToggleDropdown();
                break;
            case "Escape":
                IsOpen = false;
                break;
            case "ArrowDown":
                if (!IsOpen) ToggleDropdown();
                else MoveHighlight(1);
                break;
            case "ArrowUp":
                if (IsOpen) MoveHighlight(-1);
                break;
        }
    }

    private void OnMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            IsOpen = false;
            DropdownRef.FocusAsync();
        }
        else if (e.Key == "Tab")
        {
            IsOpen = false;
        }
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            IsOpen = false;
            DropdownRef.FocusAsync();
        }
    }

    private void MoveHighlight(int direction)
    {
        var items = FilteredItems.Where(i => !i.Disabled).ToList();
        if (!items.Any()) return;

        var currentIndex = HighlightedItem != null ? items.IndexOf(HighlightedItem) : -1;
        var newIndex = (currentIndex + direction + items.Count) % items.Count;
        HighlightedItem = items[newIndex];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && IsOpen)
        {
            await MenuRef.FocusAsync();
        }
    }
}
