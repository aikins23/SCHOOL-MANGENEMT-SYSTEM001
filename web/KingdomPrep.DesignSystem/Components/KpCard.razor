@using Microsoft.AspNetCore.Components

<div class="@GetCardClass()" @attributes="@AdditionalAttributes">
    @if (Header != null)
    {
        <div class="kp-card-header">
            @Header
        </div>
    }

    <div class="kp-card-body">
        @Body
    </div>

    @if (Footer != null)
    {
        <div class="kp-card-footer">
            @Footer
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public CardVariant Variant { get; set; } = CardVariant.Default;
    [Parameter] public bool Hoverable { get; set; } = true;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    public enum CardVariant { Default, Profile, Billing, Outlined, Elevated }

    private string GetCardClass()
    {
        var classes = new List<string> { "kp-card" };

        classes.Add(Variant switch
        {
            CardVariant.Profile => "kp-card-profile",
            CardVariant.Billing => "kp-card-billing",
            CardVariant.Outlined => "kp-card-outlined",
            CardVariant.Elevated => "kp-card-elevated",
            _ => "kp-card-default"
        });

        if (Hoverable) classes.Add("kp-card-hoverable");

        if (!string.IsNullOrWhiteSpace(Class)) classes.Add(Class);

        return string.Join(" ", classes);
    }
}
