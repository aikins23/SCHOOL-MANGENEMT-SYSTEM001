@using Microsoft.AspNetCore.Components

<button
    class="@GetButtonClass()"
    type="@Type"
    disabled="@Disabled"
    onclick="@OnClick"
    @attributes="@AdditionalAttributes">
    @if (Icon != null)
    {
        <span class="btn-icon" aria-hidden="true">@Icon</span>
    }
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Medium;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    public enum ButtonVariant { Primary, Outline, OutlineSecondary, Ghost, Danger }
    public enum ButtonSize { Small, Medium, Large }

    private string GetButtonClass()
    {
        var classes = new List<string> { "kp-btn" };

        classes.Add(Variant switch
        {
            ButtonVariant.Primary => "kp-btn-primary",
            ButtonVariant.Outline => "kp-btn-outline",
            ButtonVariant.OutlineSecondary => "kp-btn-outline-secondary",
            ButtonVariant.Ghost => "kp-btn-ghost",
            ButtonVariant.Danger => "kp-btn-danger",
            _ => "kp-btn-primary"
        });

        classes.Add(Size switch
        {
            ButtonSize.Small => "kp-btn-sm",
            ButtonSize.Medium => "kp-btn-md",
            ButtonSize.Large => "kp-btn-lg",
            _ => "kp-btn-md"
        });

        if (Disabled) classes.Add("kp-btn-disabled");
        if (!string.IsNullOrWhiteSpace(Class)) classes.Add(Class);

        return string.Join(" ", classes);
    }
}
